# Web manager. Runs only on build-farm. User unit for the ghrunner account.
[Unit]
Description=SP runner farm manager (web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=FARM_MANAGER_CONFIG=%h/.config/sp-runner/manager.toml
WorkingDirectory=%h/sp-runner-manager
ExecStart=%h/sp-runner-manager/.venv/bin/python -m uvicorn app:app \
    --host 0.0.0.0 --port 8080 --no-access-log --forwarded-allow-ips=*
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=yes
# DB + audit log live here ($XDG_STATE_HOME/sp-runner-manager).
StateDirectory=sp-runner-manager

[Install]
WantedBy=default.target
