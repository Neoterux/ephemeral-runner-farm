# Per-slot persistent config: ~ghrunner/.config/sp-runner/slot-<n>.env
# Written by the agent when a runner is created/edited from the web UI.
# Sourced by sp-runner-prestart. Plain shell KEY=VALUE, no spaces around '='.

ENABLED=true
GITHUB_URL=https://github.com/your-org
RUNNER_LABELS=self-hosted,linux,x64,podman
RUNNER_GROUP=builder
IMAGE_TAG=2026-09-08
SLOT_MEMORY=12g
SLOT_CPUS=2
